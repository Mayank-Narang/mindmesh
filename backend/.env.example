# =============================================================================
# MindMesh Backend Environment Configuration (.env.example)
# Copy this file to .env and configure appropriate values for your environment.
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mindmesh?retryWrites=true&w=majority

# JWT Authentication
# IMPORTANT: In production, generate a secure random string of at least 32 characters.
# Example command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_cryptographically_secure_jwt_secret_min_32_characters

# Google Gemini API
# Required for text embeddings (gemini-embedding-001) and RAG generation (gemini-flash-latest).
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration
# Comma-separated list of allowed origins. Use '*' only for open development.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Scraper Settings
# Timeout in milliseconds for URL metadata fetching (default: 5000ms).
SCRAPER_TIMEOUT_MS=5000

# Atlas Vector Search Index Name
# Matches the vector index created on the 'notechunks' collection.
CHUNK_VECTOR_INDEX=note_chunks_vector_index
