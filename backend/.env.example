# =============================================================================
# MindMesh Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# JWT Authentication
# A long, random secret for signing JSON Web Tokens.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# MongoDB Atlas
# Connection string from your MongoDB Atlas cluster.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=

# Google Gemini API
# API key for the Gemini Embedding 001 model.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Application
NODE_ENV=development
PORT=5000
